{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow-listed IPC for the panel window: the host's own commands and listening to its events, nothing else.",
  "windows": ["panel"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-info",
    "allow-get-settings",
    "allow-set-safe-mode",
    "allow-retry-capture",
    "allow-watch-capture",
    "allow-open-privacy-settings",
    "allow-plugin-storage-get",
    "allow-plugin-storage-set",
    "allow-game-text",
    "allow-set-display",
    "allow-share-summary",
    "allow-chat-history",
    "allow-set-chat-overlay",
    "allow-get-startup",
    "allow-set-startup",
    "allow-update-status",
    "allow-check-for-updates",
    "allow-install-update"
  ]
}
